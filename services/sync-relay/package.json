    "@dohc/workspace-auth": "workspace:*",
    "@dohc/workspace-contracts": "workspace:*",
    "@dohc/workspace-core": "workspace:*",
    "@dohc/workspace-engine-client": "workspace:*",
    "@dohc/ydoc-projection": "workspace:*",
    "better-auth": "^1.6.26",
    "pg": "^8.22.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.4",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
