{
  "name": "@dohc/sync-relay",
  "private": true,
  "type": "module",
  "exports": {
    "./self-host-live-profile": "./src/selfHostLiveProfile.ts",
    "./device-host": "./src/deviceHost.ts",
    "./owner-live-transport": "./src/ownerLiveTransport.ts",
    ".": "./src/server.ts",
