{
  "name": "@dohc/hocuspocus",
  "private": true,
  "type": "module",
  "exports": {
    "./auth": "./src/auth.ts",
    "./doc-name": "./src/doc-name.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "node scripts/require-integration-env.mjs && vitest run --config vitest.integration.config.ts",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.1.0",
    "@hocuspocus/server": "^4.1.0",
    "@tiptap/core": "^3.23.6",
    "@tiptap/extension-table": "^3.23.6",
    "@tiptap/markdown": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "jose": "^6.2.3",
    "js-yaml": "^4.1.1",
    "pg": "^8.21.0",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.19",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
