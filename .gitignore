node_modules/
.output/
dist/
coverage/
target/
*.tsbuildinfo
.env
.env.*
!.env.example
!.env.*.example
.DS_Store
.tanstack/tmp/
.gstack/tmp/
.dohc-dev/

# Playwright output
test-results/

# In-worktree cargo target dirs (the gate prefers an out-of-repo CARGO_TARGET_DIR)
target-*/
**/target-*/

# Agent state that must never be committed. These were only ignored by
# machine-local rules (~/.config/git/ignore, .git/info/exclude), which protect
# one checkout and travel with nobody.
/.claude/settings.local.json
/.claude/worktrees/
/.agent-worktrees/
/CLAUDE.local.md

# Task plans, prompts, reports, measurements, and CLI logs stay out of tracked docs.
/.agent-artifacts/
/.artifacts/
/.codex-artifacts/
# Every log a tool tees into the repo root, which is where the gates write
# theirs. The provenance row fails a tree that changes mid-run, so a log that
# `tee` creates as the run starts would race that check or stamp a pristine CI
# checkout `dirty(N)`.
/*.log

# Read-only external source clones for agent exploration.
/.agent-sources/

# Test TLS material minted on first use by services/share-web/src/testing/device-control/localhostTls.ts.
/services/share-web/src/testing/device-control/localhost-cert.pem
/services/share-web/src/testing/device-control/localhost-key.pem
/services/share-web/src/testing/device-control/tls-*/

# Temp folders that scripts/self-host/cloudflare.test.mjs makes in the repo root.
/.cloudflare-test-*/
