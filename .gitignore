# Playwright output
test-results/

# In-worktree cargo target dirs (WINDOWS_DEV prefers out-of-repo CARGO_TARGET_DIR)
target-*/
**/target-*/

# Agent state that must never be committed. These were only ignored by
# machine-local rules (~/.config/git/ignore, .git/info/exclude), which protect
# one checkout and travel with nobody.
/.claude/settings.local.json
/.claude/worktrees/
/CLAUDE.local.md

# One home for throwaway agent prompts, reports, and CLI logs. Anything worth
# keeping goes to docs/ under a real name instead of sitting at the repo root.
/.agent-artifacts/
# Every log a tool tees into the repo root, which is where the gates write
# theirs: `pr-engine-gate.log`, the macOS evidence run's `macos-*.log`, and
# `codex-*.log`. Ignoring the class keeps the gates out of the worktree they
# measure — the provenance row fails a tree that changes mid-run, and a log
# `tee` creates as the run starts would otherwise race that check or stamp a
# pristine CI checkout `dirty(N)`.
/*.log

# Read-only external source clones for agent exploration.
/.agent-sources/
