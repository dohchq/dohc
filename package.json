{
  "name": "dohc",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "setup:worktree": "node scripts/verification/setup.mjs",
    "doctor": "node scripts/verification/doctor.mjs",
    "qa:prepare": "node scripts/verification/build.mjs",
    "qa:smoke": "node scripts/verification/verify.mjs smoke",
    "qa:e2e": "node scripts/verification/verify.mjs e2e",
    "qa:debug": "node scripts/verification/debug.mjs",
    "qa:artifacts": "node scripts/verification/artifact-proof.mjs",
    "verify:plan": "node scripts/verification/verify.mjs plan",
    "verify:pr": "node scripts/verification/verify.mjs pr",
    "dev": "pnpm --filter @dohc/desktop dev",
    "dev:desktop": "pnpm --filter @dohc/desktop dev",
    "dev:site": "pnpm --filter @dohc/site dev",
    "build:desktop": "pnpm --filter @dohc/desktop build",
    "build:site": "pnpm --filter @dohc/site build",
    "test:desktop": "pnpm --filter @dohc/desktop test",
    "smoke:desktop": "node apps/desktop/scripts/smoke-test.mjs",
    "smoke:package:desktop": "node apps/desktop/scripts/package-smoke.mjs",
    "smoke:fuses:desktop": "pnpm --filter @dohc/desktop smoke:fuses",
    "test:release:desktop": "node --test scripts/desktop-release-scripts.test.mjs",
    "smoke:release:desktop": "node scripts/release-smoke.mjs",
    "mock:update:desktop": "node scripts/mock-update-server.mjs",
    "dev:workspace-api": "pnpm --filter @dohc/workspace-api dev",
    "dev:postgres": "docker compose -f docker-compose.dev.yml up -d postgres",
    "build": "pnpm -r --if-present build",
    "migrate": "node scripts/migrate-postgres.mjs",
    "reset:postgres": "node scripts/reset-postgres-dev-data.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm check:exports && node scripts/check-brand.mjs && node --test --test-concurrency=1 scripts/verification/verification.test.mjs scripts/verification/configured-hosts.test.mjs scripts/verification/postgres-cancellation.test.mjs scripts/verification/process-group.test.mjs scripts/verification/close-electron-process-group.test.mjs scripts/verification/debug.test.mjs scripts/verification/owner-cancellation.test.mjs scripts/ci-verdict-provenance.test.mjs scripts/rust-gate-artifact.test.mjs scripts/build-slot.test.mjs scripts/desktop-build-cancellation.test.mjs scripts/native-target-guard.test.mjs scripts/scratch-leak-report.test.mjs scripts/vitest-single-major.test.mjs scripts/self-host-compose.test.mjs tools/perf-profiling/run-profiles.test.mjs tools/perf-profiling/network-proxy.test.mjs tools/perf-profiling/packaged-benchmark.test.mjs && pnpm -r --if-present test",
    "test:desktop:e2e": "node scripts/verification/verify.mjs e2e",
    "test:apps:e2e": "pnpm --filter @dohc/desktop run test:apps:e2e",
    "smoke:settings:desktop": "pnpm --filter @dohc/desktop run smoke:settings",
    "check:self-host": "node scripts/check-self-host.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "check:exports": "knip --workspace @dohc/workspace-engine-client --workspace @dohc/cli --workspace @dohc/workspace-core --workspace @dohc/workspace-contracts --exports --include-entry-exports",
    "verify:ordered-delivery": "node scripts/verification/ordered-delivery.mjs",
    "verify:configured-hosts": "node scripts/verification/configured-hosts.mjs"
  },
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "js-yaml": "5.2.3",
    "knip": "6.34.0",
    "vitest": "^4.1.10"
  }
}
