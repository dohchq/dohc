{
  "name": "dohc",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "pnpm": "10.24.0"
  },
  "scripts": {
    "dev": "pnpm --filter @dohc/app --if-present run dev",
    "dev:hocuspocus": "pnpm --filter @dohc/hocuspocus --if-present run dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm --filter @dohc/app --if-present run start",
    "preview": "pnpm --filter @dohc/app --if-present run preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint"
  },
  "packageManager": "pnpm@10.24.0"
}
