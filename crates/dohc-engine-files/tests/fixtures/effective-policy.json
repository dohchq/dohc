  "filesPolicy": [
    {
      "name": "valid-multi-rule",
      "toml": "[[rule]]\npath = \"drafts/**\"\ntracked = false\nsearchable = false\n\n[[rule]]\npath = \"docs/*.md\"\nsearchable = true\n",
      "ok": true,
      "rules": [
        {
          "path": "drafts/**",
          "tracked": false,
          "searchable": false
        },
        {
          "path": "docs/*.md",
          "searchable": true
        }
      ]
    },
    {
      "name": "valid-inline-array",
      "toml": "rule = [{ path = \"a.md\", tracked = true }]\n",
      "ok": true,
      "rules": [
        {
          "path": "a.md",
          "tracked": true
        }
      ]
    },
    {
      "name": "valid-empty-rule-array",
      "toml": "rule = []\n",
      "ok": true,
      "rules": []
    },
    {
      "name": "valid-path-only",
      "toml": "[[rule]]\npath = \"**\"\n",
      "ok": true,
      "rules": [
        {
          "path": "**"
        }
      ]
    },
    {
      "name": "empty-document",
      "toml": "",
      "ok": false,
      "errors": [
        "policy must contain exactly one top-level key: rule",
        "rule must be an array of tables"
      ]
    },
    {
      "name": "only-unknown-top-level-key",
      "toml": "foo = 1\n",
      "ok": false,
      "errors": [
        "unknown top-level key: foo",
        "policy must contain exactly one top-level key: rule",
        "rule must be an array of tables"
      ]
    },
    {
      "name": "unknown-top-level-key-with-rules",
      "toml": "version = true\n[[rule]]\npath = \"x.md\"\n",
      "ok": false,
      "errors": [
        "unknown top-level key: version",
        "policy must contain exactly one top-level key: rule"
      ]
    },
    {
      "name": "unknown-top-level-keys-integer-like",
      "toml": "zeta = 1\n2 = 2\n1 = 3\n",
      "ok": false,
      "errors": [
        "unknown top-level key: 1",
        "unknown top-level key: 2",
        "unknown top-level key: zeta",
        "policy must contain exactly one top-level key: rule",
        "rule must be an array of tables"
      ]
    },
    {
      "name": "rule-not-array",
      "toml": "rule = \"not-array\"\n",
      "ok": false,
      "errors": [
        "rule must be an array of tables"
      ]
    },
    {
      "name": "rule-is-table",
      "toml": "[rule]\npath = \"x.md\"\n",
      "ok": false,
      "errors": [
        "rule must be an array of tables"
      ]
    },
    {
      "name": "rule-entry-not-table",
      "toml": "rule = [1]\n",
      "ok": false,
      "errors": [
        "rule 1: rule entry must be an object"
      ]
    },
    {
      "name": "rule-entry-array",
      "toml": "rule = [[1]]\n",
      "ok": false,
      "errors": [
        "rule 1: rule entry must be an object"
      ]
    },
    {
      "name": "missing-path",
      "toml": "[[rule]]\ntracked = false\n",
      "ok": false,
