        "rule 1: unknown key: mode"
      ]
    },
    {
      "name": "unknown-rule-keys-out-of-order",
      "toml": "[[rule]]\npath = \"x.md\"\nzeta = 1\nalpha = 2\n",
      "ok": false,
      "errors": [
        "rule 1: unknown key: zeta",
        "rule 1: unknown key: alpha"
      ]
    },
    {
      "name": "unknown-rule-keys-integer-like",
      "toml": "[[rule]]\npath = \"x.md\"\nzeta = 1\n2 = 2\n1 = 3\n",
      "ok": false,
