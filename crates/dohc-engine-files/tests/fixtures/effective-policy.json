    },
    {
      "name": "unknown-rule-keys-array-index-boundary",
      "toml": "[[rule]]\npath = \"x.md\"\n4294967295 = 1\n4294967294 = 2\n0 = 3\n",
      "ok": false,
      "errors": [
        "rule 1: unknown key: 0",
        "rule 1: unknown key: 4294967294",
        "rule 1: unknown key: 4294967295"
      ]
    },
    {
      "name": "tracked-not-boolean",
      "toml": "[[rule]]\npath = \"x.md\"\ntracked = \"false\"\n",
      "ok": false,
      "errors": [
        "rule 1: tracked must be a boolean"
      ]
    },
    {
      "name": "searchable-not-boolean",
      "toml": "[[rule]]\npath = \"x.md\"\nsearchable = 1\n",
      "ok": false,
      "errors": [
        "rule 1: searchable must be a boolean"
      ]
    },
    {
      "name": "invalid-path-glob",
      "toml": "[[rule]]\npath = \"bad/**/x.md\"\ntracked = false\n",
      "ok": false,
      "errors": [
        "rule 1: invalid path glob \"bad/**/x.md\": ** is only supported as the final segment"
