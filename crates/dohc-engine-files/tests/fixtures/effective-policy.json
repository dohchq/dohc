    },
    {
      "name": "toml-syntax-error",
      "toml": "[[rule]\npath = \"x.md\"\n",
      "ok": false,
      "parserMessage": true,
      "errors": [
        "invalid TOML: Invalid TOML document: each key-value declaration must be followed by an end-of-line\n\n1:  [[rule]\n2:  path = \"x.md\"\n    ^\n"
      ]
    },
    {
      "name": "toml-duplicate-key",
      "toml": "[[rule]]\npath = \"a.md\"\npath = \"b.md\"\n",
      "ok": false,
      "parserMessage": true,
      "errors": [
        "invalid TOML: Invalid TOML document: trying to redefine an already defined table or value\n\n2:  path = \"a.md\"\n3:  path = \"b.md\"\n    ^\n"
      ]
    },
    {
      "name": "toml-duplicate-table",
      "toml": "[table]\nx = 1\n\n[table]\ny = 2\n",
      "ok": false,
      "parserMessage": true,
      "errors": [
        "invalid TOML: Invalid TOML document: trying to redefine an already defined table or value\n\n4:  [table]\n     ^\n5:  y = 2\n"
      ]
    }
