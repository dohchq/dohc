    },
    {
      "name": "second-rule-invalid-rejects-all",
      "toml": "[[rule]]\npath = \"ok.md\"\ntracked = false\n[[rule]]\npath = \"bad[\"\n",
      "ok": false,
      "errors": [
        "rule 2: invalid path glob \"bad[\": glob character classes, braces, and ? are not supported"
