{
  admin off
}

{$DOHC_PUBLIC_HOST} {
  @internal path /internal/*
  handle @internal {
    respond 404
  }
  @home path /
  redir @home /account 302
  @account path /account /account/* /device /api/auth/* /.well-known/dohc-server
  handle @account {
    reverse_proxy workspace-api:1786
  }
  @relay path /sync/*
  handle @relay {
    # The relay's largest per-route body cap. A Collection import streams a
    # whole Collection and bounds itself.
    @relayBounded not path_regexp ^/sync/[^/]+/datasets/[^/]+/imports/[^/]+$
    request_body @relayBounded {
      max_size 21MiB
    }
    reverse_proxy sync-relay:1788
  }
  handle {
    reverse_proxy share-web:1790
  }
}
