{
  admin off
  servers {
    import /etc/caddy/cloudflare-proxies.caddy
    client_ip_headers CF-Connecting-IP
  }
}

{$DOHC_PUBLIC_HOST} {
  @internal path /internal/*
  handle @internal {
    respond 404
  }
  @home path /
  redir @home /account 302
  @account path /account /account/* /device /api/auth/* /.well-known/dohc-server
  handle @account {
    reverse_proxy workspace-api:1786 {
      lb_try_duration 30s
      header_up X-Forwarded-For {client_ip}
      header_up X-Forwarded-Host {host}
      header_up X-Forwarded-Proto https
    }
  }
  @relay path /sync/*
  handle @relay {
    # Incoming webhook URLs carry their bearer token in `/sync/hooks/:token`.
    # If you enable Caddy access logs (`log`), redact `request>uri` for
    # `/sync/hooks/*` (e.g. `format filter { fields { request>uri regexp ^/sync/hooks/[^/?#]+ /sync/hooks/[REDACTED] } }`)
    # so raw webhook tokens are never written to disk logs.
    # The relay's largest per-route body cap. A Collection import streams a
    # whole Collection and bounds itself.
    @relayBounded not path_regexp ^/sync/[^/]+/datasets/[^/]+/imports/[^/]+$
    request_body @relayBounded {
      max_size 28MiB
    }
    reverse_proxy sync-relay:1788 {
      lb_try_duration 30s
      header_up X-Forwarded-For {client_ip}
      header_up X-Forwarded-Host {host}
      header_up X-Forwarded-Proto https
    }
  }
  handle {
    reverse_proxy share-web:1790 {
      lb_try_duration 30s
      header_up X-Forwarded-For {client_ip}
      header_up X-Forwarded-Host {host}
      header_up X-Forwarded-Proto https
    }
  }
}
