# dohc Drive's server settings. See docs/how-to/drive.md.
# Copy each value into the configuration file that bootstrap init created, replacing the value there.
# Replace every <placeholder>. drive.mjs refuses to run while one is left.
# Credentials never go in this file or in the repository. Add them on the server only, as docs/how-to/drive.md describes.

# Release: the image that the release bundle's release.json records.
DOHC_IMAGE=dohc-self-host:<release-revision>

DOHC_PUBLIC_ORIGIN=https://drive.dohc.computer
DOHC_PUBLIC_HOST=drive.dohc.computer
DOHC_SERVER_NAME='dohc Drive'
DOHC_SERVER_NETWORK_ACCESS=public
DOHC_BEHIND_CLOUDFLARE=1

# The relay accepts live editing on these hosts: drive.dohc.computer,sync-relay:1788.
# The release derives that list from DOHC_PUBLIC_HOST, so nothing else sets it.

# The DigitalOcean volume, mounted by its filesystem UUID at /mnt/dohc-drive.
# drive.mjs takes the UUID as --volume-uuid <volume-uuid>.
DOHC_DATA_DIRECTORY=/mnt/dohc-drive/dohc

# Accounts live in Neon (AWS us-east-1). Use the direct endpoint, not the pooled one.
# The release connects with sslmode=verify-full and needs Neon's CA file to check the server certificate.
# Neon's certificates chain to ISRG Root X1. Download its PEM from the link in Neon's secure connections guide.
# Also add POSTGRES_PASSWORD on the server.
DOHC_POSTGRES_HOST=<neon-direct-endpoint-host>
DOHC_POSTGRES_PORT=5432
DOHC_POSTGRES_CA_FILE=/etc/dohc/postgres-ca.pem
POSTGRES_DB=<neon-database>
POSTGRES_USER=<neon-role>

# Mail goes through Postmark's SMTP service on port 2525 with STARTTLS.
# DigitalOcean blocks outbound ports 25, 465, and 587 on new Droplets. Postmark accepts STARTTLS on port 2525.
# Also add DOHC_SMTP_USER and DOHC_SMTP_PASSWORD on the server.
DOHC_SMTP_HOST=smtp.postmarkapp.com
DOHC_SMTP_PORT=2525
DOHC_SMTP_SECURE=false
DOHC_SMTP_FROM=noreply@drive.dohc.computer

# Sign-up stays private. Add the approved addresses on the server only.
DOHC_SIGN_UP_EMAILS=<approved-addresses>

# Published apps, served behind Cloudflare with an Origin CA certificate for *.dohc.app.
DOHC_RELAY_APP_PUBLICATIONS=1
DOHC_SHARE_WEB_APP_DOMAIN=dohc.app
DOHC_APP_TLS_CERT_FILE=/etc/dohc/app-tls/cert.pem
DOHC_APP_TLS_KEY_FILE=/etc/dohc/app-tls/key.pem

# Hourly snapshots in Cloudflare R2. Also add the access key ID, the secret access key,
# DOHC_SNAPSHOT_ALERT_EMAIL, and the Healthchecks.io URL in DOHC_SNAPSHOT_HEARTBEAT_URL on the server.
DOHC_SNAPSHOT_S3_ENDPOINT=https://<r2-account-id>.r2.cloudflarestorage.com
DOHC_SNAPSHOT_S3_REGION=auto
DOHC_SNAPSHOT_S3_BUCKET=<r2-bucket>
