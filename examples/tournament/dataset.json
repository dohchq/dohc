{
  "formatVersion": 2,
  "datasetId": "7c0a7c51-3f1e-4b0e-9a55-1d2f7f0c0a11",
  "name": "Tournament",
  "tables": [
    {
      "name": "Tournaments",
      "sqlName": "tournaments",
      "primaryKey": "id",
      "fields": [
        { "name": "ID", "sqlColumn": "id", "type": "text" },
        { "name": "Name", "sqlColumn": "name", "type": "text", "required": true },
        {
          "name": "Sport",
          "sqlColumn": "sport",
          "type": "select",
          "required": true,
          "options": ["Pickleball", "Esports", "Tabletop"]
        },
        {
          "name": "Status",
          "sqlColumn": "status",
          "type": "select",
          "required": true,
          "options": ["live", "finished"]
        },
        { "name": "Bracket size", "sqlColumn": "bracket_size", "type": "number", "required": true },
        { "name": "Points to win", "sqlColumn": "points_to_win", "type": "number", "required": true },
        { "name": "Win by", "sqlColumn": "win_by", "type": "number", "required": true },
        { "name": "Rating K-factor", "sqlColumn": "k_factor", "type": "number", "required": true },
        {
          "name": "Champion",
          "sqlColumn": "champion_id",
          "type": "relation",
          "relation": { "table": "players", "field": "id" }
        },
        { "name": "Created", "sqlColumn": "created_at", "type": "number", "required": true },
        { "name": "Updated", "sqlColumn": "updated_at", "type": "number", "required": true }
      ]
    },
    {
      "name": "Players",
      "sqlName": "players",
      "primaryKey": "id",
      "fields": [
        { "name": "ID", "sqlColumn": "id", "type": "text" },
        {
          "name": "Tournament",
          "sqlColumn": "tournament_id",
          "type": "relation",
          "required": true,
          "relation": { "table": "tournaments", "field": "id" }
        },
        { "name": "Name", "sqlColumn": "name", "type": "text", "required": true },
        { "name": "Club", "sqlColumn": "club", "type": "text" },
        { "name": "Seed", "sqlColumn": "seed", "type": "number", "required": true },
        { "name": "Rating", "sqlColumn": "rating", "type": "number", "required": true },
        { "name": "Starting rating", "sqlColumn": "start_rating", "type": "number", "required": true },
        { "name": "Wins", "sqlColumn": "wins", "type": "number", "required": true },
        { "name": "Losses", "sqlColumn": "losses", "type": "number", "required": true },
        { "name": "Points for", "sqlColumn": "points_for", "type": "number", "required": true },
        { "name": "Points against", "sqlColumn": "points_against", "type": "number", "required": true },
        { "name": "Out in round", "sqlColumn": "eliminated_round", "type": "number" }
      ]
    },
    {
      "name": "Courts",
      "sqlName": "courts",
      "primaryKey": "id",
      "fields": [
        { "name": "ID", "sqlColumn": "id", "type": "text" },
        {
          "name": "Tournament",
          "sqlColumn": "tournament_id",
          "type": "relation",
          "required": true,
          "relation": { "table": "tournaments", "field": "id" }
        },
        { "name": "Name", "sqlColumn": "name", "type": "text", "required": true },
        { "name": "Position", "sqlColumn": "position", "type": "number", "required": true }
      ]
    },
    {
      "name": "Matches",
      "sqlName": "matches",
      "primaryKey": "id",
      "fields": [
        { "name": "ID", "sqlColumn": "id", "type": "text" },
        {
          "name": "Tournament",
          "sqlColumn": "tournament_id",
          "type": "relation",
          "required": true,
          "relation": { "table": "tournaments", "field": "id" }
        },
        { "name": "Round", "sqlColumn": "round", "type": "number", "required": true },
        { "name": "Slot", "sqlColumn": "slot", "type": "number", "required": true },
        {
          "name": "Player A",
          "sqlColumn": "player_a_id",
          "type": "relation",
          "relation": { "table": "players", "field": "id" }
        },
        {
          "name": "Player B",
          "sqlColumn": "player_b_id",
          "type": "relation",
          "relation": { "table": "players", "field": "id" }
        },
        {
          "name": "Winner goes to",
          "sqlColumn": "next_match_id",
          "type": "relation",
          "relation": { "table": "matches", "field": "id" }
        },
        {
          "name": "Winner's side",
          "sqlColumn": "next_slot",
          "type": "select",
          "options": ["a", "b"]
        },
        {
          "name": "Court",
          "sqlColumn": "court_id",
          "type": "relation",
          "relation": { "table": "courts", "field": "id" }
        },
        {
          "name": "Status",
          "sqlColumn": "status",
          "type": "select",
          "required": true,
          "options": ["waiting", "ready", "live", "done", "bye"]
        },
        { "name": "Score A", "sqlColumn": "score_a", "type": "number", "required": true },
        { "name": "Score B", "sqlColumn": "score_b", "type": "number", "required": true },
        {
          "name": "Winner",
          "sqlColumn": "winner_id",
          "type": "relation",
          "relation": { "table": "players", "field": "id" }
        },
        { "name": "Started", "sqlColumn": "started_at", "type": "number" },
        { "name": "Finished", "sqlColumn": "finished_at", "type": "number" },
        { "name": "Version", "sqlColumn": "version", "type": "number", "required": true }
      ]
    },
    {
      "name": "Match events",
      "sqlName": "match_events",
      "primaryKey": "id",
      "fields": [
        { "name": "ID", "sqlColumn": "id", "type": "text" },
        {
          "name": "Tournament",
          "sqlColumn": "tournament_id",
          "type": "relation",
          "required": true,
          "relation": { "table": "tournaments", "field": "id" }
        },
        {
          "name": "Match",
          "sqlColumn": "match_id",
          "type": "relation",
          "required": true,
          "relation": { "table": "matches", "field": "id" }
        },
        { "name": "Sequence", "sqlColumn": "seq", "type": "number", "required": true },
        {
          "name": "Kind",
          "sqlColumn": "kind",
          "type": "select",
          "required": true,
          "options": ["bye", "start", "point", "undo", "complete"]
        },
        { "name": "Side", "sqlColumn": "side", "type": "select", "options": ["a", "b"] },
        { "name": "Score A", "sqlColumn": "score_a", "type": "number", "required": true },
        { "name": "Score B", "sqlColumn": "score_b", "type": "number", "required": true },
        { "name": "Court", "sqlColumn": "court_id", "type": "text" },
        { "name": "Changed by", "sqlColumn": "actor", "type": "text", "required": true },
        { "name": "At", "sqlColumn": "at", "type": "number", "required": true }
      ]
    }
  ],
  "operations": [
    {
      "name": "liveSnapshot",
      "label": "Live bracket, courts, and standings",
      "table": "matches",
      "kind": "read",
      "access": "link",
      "readOnly": true,
      "fields": [
        "id",
        "round",
        "slot",
        "player_a_id",
        "player_b_id",
        "next_match_id",
        "next_slot",
        "court_id",
        "status",
        "score_a",
        "score_b",
        "winner_id",
        "started_at",
        "finished_at",
        "version"
      ]
    },
    {
      "name": "matchLog",
      "label": "Point-by-point log",
      "table": "match_events",
      "kind": "read",
      "access": "helper",
      "readOnly": true,
      "fields": ["seq", "kind", "side", "score_a", "score_b", "court_id", "actor", "at"]
    },
    {
      "name": "createTournament",
      "label": "Create a tournament and its bracket",
      "table": "tournaments",
      "kind": "action",
      "access": "owner",
      "readOnly": false,
      "fields": ["name", "sport", "bracket_size", "points_to_win", "win_by", "k_factor"]
    },
    {
      "name": "seedDemo",
      "label": "Load the 16-player demo tournament",
      "table": "tournaments",
      "kind": "action",
      "access": "owner",
      "readOnly": false,
      "fields": ["name", "sport", "bracket_size"]
    },
    {
      "name": "startMatch",
      "label": "Start a match on a court",
      "table": "matches",
      "kind": "action",
      "access": "helper",
      "readOnly": false,
      "fields": ["court_id", "status", "started_at", "version"]
    },
    {
      "name": "scorePoint",
      "label": "Add a point",
      "table": "matches",
      "kind": "action",
      "access": "helper",
      "readOnly": false,
      "fields": ["score_a", "score_b", "version"]
    },
    {
      "name": "undoPoint",
      "label": "Undo the last point",
      "table": "matches",
      "kind": "action",
      "access": "helper",
      "readOnly": false,
      "fields": ["score_a", "score_b", "version"]
    },
    {
      "name": "completeMatch",
      "label": "Complete a match and advance the winner",
      "table": "matches",
      "kind": "action",
      "access": "helper",
      "readOnly": false,
      "fields": ["status", "winner_id", "finished_at", "version"]
    }
  ]
}
