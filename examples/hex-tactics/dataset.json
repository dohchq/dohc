{
  "formatVersion": 2,
  "datasetId": "22222222-2222-4222-8222-222222222201",
  "name": "HexClash",
  "schemaPath": "schema.sql",
  "operationsPath": "operations.js",
  "tables": [
    {
      "name": "Games",
      "sqlName": "games",
      "primaryKey": "id",
      "fields": [
        { "name": "ID", "sqlColumn": "id", "type": "text", "required": true, "unique": true },
        { "name": "Join code", "sqlColumn": "join_code", "type": "text", "required": true, "unique": true },
        { "name": "Title", "sqlColumn": "title", "type": "text", "required": true },
        { "name": "Seed", "sqlColumn": "seed", "type": "number", "required": true },
        { "name": "Radius", "sqlColumn": "radius", "type": "number", "required": true },
        {
          "name": "Status",
          "sqlColumn": "status",
          "type": "select",
          "required": true,
          "options": ["waiting", "active", "finished"]
        },
        { "name": "Turn number", "sqlColumn": "turn_number", "type": "number", "required": true },
        { "name": "Active seat", "sqlColumn": "active_seat", "type": "number", "required": true },
        { "name": "Winner", "sqlColumn": "winner_player_id", "type": "text" },
        {
          "name": "Win reason",
          "sqlColumn": "win_reason",
          "type": "select",
          "options": ["capital_captured", "resignation"]
        },
        { "name": "Created at", "sqlColumn": "created_at_ms", "type": "number", "required": true },
        { "name": "Updated at", "sqlColumn": "updated_at_ms", "type": "number", "required": true }
      ]
    },
    {
      "name": "Players",
      "sqlName": "players",
      "primaryKey": "id",
      "fields": [
        { "name": "ID", "sqlColumn": "id", "type": "text", "required": true, "unique": true },
        {
          "name": "Game",
          "sqlColumn": "game_id",
          "type": "relation",
          "required": true,
          "relation": { "table": "games", "field": "id" }
        },
        { "name": "Seat", "sqlColumn": "seat", "type": "number", "required": true },
        { "name": "Name", "sqlColumn": "name", "type": "text", "required": true },
        {
          "name": "Color",
          "sqlColumn": "color",
          "type": "select",
          "required": true,
          "options": ["crimson", "cobalt"]
        },
        { "name": "Gold", "sqlColumn": "gold", "type": "number", "required": true },
        { "name": "Joined at", "sqlColumn": "joined_at_ms", "type": "number", "required": true }
      ]
    },
    {
      "name": "Hex tiles",
      "sqlName": "hex_tiles",
      "primaryKey": "id",
      "fields": [
        { "name": "ID", "sqlColumn": "id", "type": "text", "required": true, "unique": true },
        {
          "name": "Game",
          "sqlColumn": "game_id",
          "type": "relation",
          "required": true,
          "relation": { "table": "games", "field": "id" }
        },
        { "name": "Q", "sqlColumn": "q", "type": "number", "required": true },
        { "name": "R", "sqlColumn": "r", "type": "number", "required": true },
        {
          "name": "Terrain",
          "sqlColumn": "terrain",
          "type": "select",
          "required": true,
          "options": ["capital", "plains", "gold", "forest", "mountain"]
        },
        {
          "name": "Owner",
          "sqlColumn": "owner_player_id",
          "type": "relation",
          "relation": { "table": "players", "field": "id" }
        },
        { "name": "Units", "sqlColumn": "units", "type": "number", "required": true },
        { "name": "Fortified", "sqlColumn": "fortified", "type": "checkbox", "required": true }
      ]
    },
    {
      "name": "Moves",
      "sqlName": "moves",
      "primaryKey": "id",
      "fields": [
        { "name": "ID", "sqlColumn": "id", "type": "text", "required": true, "unique": true },
        {
          "name": "Game",
          "sqlColumn": "game_id",
          "type": "relation",
          "required": true,
          "relation": { "table": "games", "field": "id" }
        },
        { "name": "Turn number", "sqlColumn": "turn_number", "type": "number", "required": true },
        {
          "name": "Actor",
          "sqlColumn": "actor_player_id",
          "type": "relation",
          "required": true,
          "relation": { "table": "players", "field": "id" }
        },
        {
          "name": "Action",
          "sqlColumn": "action_type",
          "type": "select",
          "required": true,
          "options": ["march", "fortify", "reinforce", "pass", "resign"]
        },
        { "name": "From hex", "sqlColumn": "from_hex", "type": "text" },
        { "name": "To hex", "sqlColumn": "to_hex", "type": "text" },
        { "name": "Units moved", "sqlColumn": "units_moved", "type": "number", "required": true },
        { "name": "Combat outcome", "sqlColumn": "combat_outcome_json", "type": "text", "required": true },
        { "name": "Created at", "sqlColumn": "created_at_ms", "type": "number", "required": true }
      ]
    }
  ],
  "operations": [
