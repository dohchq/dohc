      "fields": []
    },
    {
      "name": "joinGame",
      "label": "Join game",
      "table": "players",
      "kind": "action",
      "access": "link",
      "readOnly": false,
      "fields": []
    },
    {
      "name": "startDemoMatch",
      "label": "Start demo match",
      "table": "games",
      "kind": "action",
      "access": "link",
      "readOnly": false,
      "fields": []
    },
    {
      "name": "getVisibleState",
      "label": "Get visible board state",
      "table": "hex_tiles",
      "kind": "action",
      "access": "link",
      "readOnly": true,
      "fields": []
    },
    {
      "name": "submitMove",
      "label": "Submit turn move",
      "table": "moves",
      "kind": "action",
      "access": "link",
      "readOnly": false,
      "fields": []
    },
    {
      "name": "replayGame",
      "label": "Replay completed match",
      "table": "moves",
