{
  "formatVersion": 2,
  "datasetId": "7a1c0b9e-3f42-4d8a-9b6e-2c5d8f1a4e70",
  "name": "Lightbox proofing",
  "schemaPath": "schema.sql",
  "operationsPath": "operations.js",
  "tables": [
    {
      "name": "Shoots",
      "sqlName": "shoots",
      "primaryKey": "id",
      "fields": [
        { "name": "ID", "sqlColumn": "id", "type": "text" },
        { "name": "Title", "sqlColumn": "title", "type": "text", "required": true },
        { "name": "Client", "sqlColumn": "client_name", "type": "text", "required": true },
        { "name": "Shot on", "sqlColumn": "shot_on", "type": "date", "required": true },
        {
          "name": "Selection limit",
          "sqlColumn": "selection_limit",
          "type": "number",
          "required": true
        },
        {
          "name": "Status",
          "sqlColumn": "status",
          "type": "select",
          "required": true,
          "options": ["draft", "proofing", "delivered"]
        },
        {
          "name": "Internal rate cents",
          "sqlColumn": "internal_rate_cents",
          "type": "number",
          "required": true
        },
        {
          "name": "Access code",
          "sqlColumn": "access_code",
          "type": "text",
          "required": true,
          "unique": true
        },
        { "name": "Created at", "sqlColumn": "created_at_ms", "type": "number", "required": true }
      ]
    },
    {
      "name": "Assets",
      "sqlName": "assets",
      "primaryKey": "id",
      "fields": [
        { "name": "ID", "sqlColumn": "id", "type": "text" },
        {
          "name": "Shoot",
          "sqlColumn": "shoot_id",
          "type": "relation",
          "required": true,
          "relation": { "table": "shoots", "field": "id" }
        },
        { "name": "Title", "sqlColumn": "title", "type": "text", "required": true },
        { "name": "File", "sqlColumn": "file_id", "type": "attachment" },
        { "name": "Demo scene", "sqlColumn": "demo_scene", "type": "text" },
        {
          "name": "Type",
          "sqlColumn": "mime_type",
          "type": "select",
          "required": true,
          "options": ["image/jpeg", "image/png", "image/webp"]
        },
        { "name": "Width", "sqlColumn": "width", "type": "number", "required": true },
        { "name": "Height", "sqlColumn": "height", "type": "number", "required": true },
        { "name": "Bytes", "sqlColumn": "byte_length", "type": "number", "required": true },
        { "name": "Order", "sqlColumn": "sort_order", "type": "number", "required": true },
        { "name": "Rating", "sqlColumn": "owner_rating", "type": "number", "required": true },
        {
          "name": "Color label",
          "sqlColumn": "color_label",
          "type": "select",
          "required": true,
          "options": ["none", "red", "yellow", "green", "blue", "purple"]
        },
        { "name": "Published", "sqlColumn": "is_published", "type": "checkbox", "required": true },
        { "name": "Created at", "sqlColumn": "created_at_ms", "type": "number", "required": true }
      ]
    },
    {
      "name": "Selections",
      "sqlName": "selections",
      "primaryKey": "id",
      "fields": [
        { "name": "ID", "sqlColumn": "id", "type": "text" },
        {
          "name": "Asset",
          "sqlColumn": "asset_id",
          "type": "relation",
          "required": true,
          "relation": { "table": "assets", "field": "id" }
        },
        { "name": "Reviewer", "sqlColumn": "reviewer_key", "type": "text", "required": true },
        { "name": "Selected", "sqlColumn": "selected", "type": "checkbox", "required": true },
        { "name": "Updated at", "sqlColumn": "updated_at_ms", "type": "number", "required": true }
      ]
    },
    {
      "name": "Annotations",
      "sqlName": "annotations",
      "primaryKey": "id",
      "fields": [
        { "name": "ID", "sqlColumn": "id", "type": "text" },
        {
          "name": "Asset",
          "sqlColumn": "asset_id",
          "type": "relation",
          "required": true,
          "relation": { "table": "assets", "field": "id" }
        },
        { "name": "X %", "sqlColumn": "x_pct", "type": "number", "required": true },
        { "name": "Y %", "sqlColumn": "y_pct", "type": "number", "required": true },
        { "name": "Author", "sqlColumn": "author_name", "type": "text", "required": true },
        { "name": "Comment", "sqlColumn": "body", "type": "text", "required": true },
        { "name": "Resolved", "sqlColumn": "resolved", "type": "checkbox", "required": true },
        { "name": "Created at", "sqlColumn": "created_at_ms", "type": "number", "required": true }
      ]
    }
  ],
  "operations": [
