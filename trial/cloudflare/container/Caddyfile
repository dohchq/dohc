{
	admin off
	auto_https off
	persist_config off
	# The Worker is the only way in, and it replaces X-Forwarded-For with the
	# visitor's address. Forward exactly that address to the services, which
	# trust only 127.0.0.1.
	servers {
		trusted_proxies static 0.0.0.0/0 ::/0
		client_ip_headers X-Forwarded-For
	}
}

:8080 {
	@home path /
	redir @home /account 302
	@stats path /__trial/stats
	handle @stats {
		reverse_proxy 127.0.0.1:8099
	}
	@mail path /__trial/mail /__trial/mail/*
	handle @mail {
		reverse_proxy 127.0.0.1:8025
	}
	@account path /account /account/* /device /api/auth/* /.well-known/dohc-server
	handle @account {
		reverse_proxy 127.0.0.1:1786 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	@relay path /sync/*
	handle @relay {
		reverse_proxy 127.0.0.1:1788 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:1790 {
			header_up X-Forwarded-For {client_ip}
		}
	}
}
