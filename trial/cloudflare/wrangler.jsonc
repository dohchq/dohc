{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dohc-cloudflare-trial",
  "account_id": "afe5aa946bc777c3b65c8648e17b4f24",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false,
  "containers": [
    {
      "class_name": "Cell",
      "image": "./container/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1,
      "constraints": { "jurisdiction": "eu" }
    },
    {
      "class_name": "WorkspaceCell",
      "image": "./container/Dockerfile",
      "instance_type": "basic",
      "max_instances": 8,
      "constraints": { "jurisdiction": "eu" }
    }
  ],
  "r2_buckets": [{ "binding": "STATE", "bucket_name": "dohc-cloudflare-trial-state", "jurisdiction": "eu" }],
  "durable_objects": {
    "bindings": [{ "name": "CELL", "class_name": "Cell" }, { "name": "WORKSPACE", "class_name": "WorkspaceCell" }]
  },
  "exports": {
    "Cell": { "type": "durable-object", "storage": "sqlite" },
    "WorkspaceCell": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "SLEEP_AFTER": "10m",
    "CELL_SHAPE": "single",
    "DOHC_PUBLIC_ORIGIN": "https://dohc-cloudflare-trial.dohc.workers.dev"
  }
}
