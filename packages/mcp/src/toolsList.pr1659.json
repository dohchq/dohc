  "ownerToolAdditions": [
    {
      "name": "dohc_publish_app",
      "description": "Create a share link, prepare an immutable app revision, and approve publication with local owner authority. createLink requires a stable operationId; retries return the existing grant, never another link. Paths default to the app root at View access. A URL is a bearer credential at its stated access level, usable by anyone holding it. Keep its secret yourself. Append the returned appQuery before the fragment of any link URL, including one returned by createLink. Never send its secret to dohc. Rotation remains in the desktop. Agent labels are agent-declared provenance.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "action": { "type": "string", "const": "createLink" },
                  "workspaceId": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "appRoot": { "type": "string", "minLength": 1, "maxLength": 1024 },
                  "paths": { "minItems": 1, "maxItems": 100, "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
                  "access": { "default": "view", "type": "string", "enum": ["view", "comment", "edit"] },
                  "operationId": { "type": "string", "format": "uuid", "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$" },
                  "agentLabel": { "type": "string", "minLength": 1, "maxLength": 160 }
                },
                "required": ["action", "workspaceId", "appRoot", "operationId"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": { "type": "string", "const": "listLocal" },
                  "workspaceId": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "appRoot": { "type": "string", "minLength": 1, "maxLength": 1024 }
                },
                "required": ["action", "workspaceId", "appRoot"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": { "type": "string", "const": "prepareLocal" },
                  "workspaceId": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "appRoot": { "type": "string", "minLength": 1, "maxLength": 1024 }
                },
                "required": ["action", "workspaceId", "appRoot"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": { "type": "string", "const": "launchLocal" },
                  "workspaceId": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "publicationId": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                },
                "required": ["action", "workspaceId", "publicationId"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": { "type": "string", "const": "list" },
                  "workspaceId": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "appRoot": { "type": "string", "minLength": 1, "maxLength": 1024 },
                  "cursor": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                },
                "required": ["action", "workspaceId", "appRoot"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": { "type": "string", "const": "prepare" },
                  "workspaceId": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "appRoot": { "type": "string", "minLength": 1, "maxLength": 1024 },
                  "shareId": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "grantId": { "type": "string", "minLength": 1, "maxLength": 200 }
                },
                "required": ["action", "workspaceId", "appRoot", "shareId", "grantId"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": { "type": "string", "const": "approve" },
                  "workspaceId": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "approvalId": { "type": "string", "format": "uuid", "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$" },
                  "candidateDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "agentLabel": { "type": "string", "minLength": 1, "maxLength": 160 },
                  "linkReads": {
                    "maxItems": 128, "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "operationId": { "type": "string", "format": "uuid", "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$" },
                        "fieldIds": { "maxItems": 128, "type": "array", "items": { "type": "string", "format": "uuid", "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$" } }
                      },
                      "required": ["operationId", "fieldIds"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["action", "workspaceId", "approvalId", "candidateDigest"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": { "type": "string", "const": "cancel" },
                  "workspaceId": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "approvalId": { "type": "string", "format": "uuid", "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$" }
                },
                "required": ["action", "workspaceId", "approvalId"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": { "type": "string", "const": "withdraw" },
                  "workspaceId": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "publicationId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "expectedAuthorityRevision": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
                },
                "required": ["action", "workspaceId", "publicationId", "expectedAuthorityRevision"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": { "type": "string", "const": "revokeCollection" },
                  "workspaceId": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "publicationId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                  "expectedAuthorityRevision": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
                },
                "required": ["action", "workspaceId", "publicationId", "expectedAuthorityRevision"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "action": { "type": "string", "const": "reviewReactivation" },
                  "workspaceId": { "type": "string", "minLength": 1, "maxLength": 200 },
                  "publicationId": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                },
                "required": ["action", "workspaceId", "publicationId"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": ["request"],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "execution": { "taskSupport": "forbidden" }
    }
  ]
}
