{
  "expo": {
    "name": "dohc",
    "slug": "dohc",
    "scheme": "dohc",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.dohc.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.dohc.mobile"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
