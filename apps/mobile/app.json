{
  "expo": {
    "name": "dohc",
    "slug": "dohc",
    "scheme": "dohc",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.dohc.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.dohc.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/iosCameraWithoutBarcodeCompanion",
      [
        "expo-camera",
        {
          "cameraPermission": "dohc uses the camera to scan the QR code under Connect a phone on your computer.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
