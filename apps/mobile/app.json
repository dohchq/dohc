{
  "expo": {
    "name": "dohc",
    "slug": "dohc",
    "scheme": "dohc",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.dohc.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.dohc.mobile",
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "./plugins/apsEnvironmentPerBuild",
      "./plugins/androidLaunchTheme",
      "expo-document-picker",
      "expo-notifications",
      "./plugins/iosCameraWithoutBarcodeCompanion",
      [
        "expo-camera",
        {
          "cameraPermission": "dohc uses the camera to scan the QR code under Connect a phone on your computer.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "dohc",
    "extra": {
      "eas": {
        "projectId": "e53b2b15-d4c9-488d-8dc3-a77d7c370ed9"
      }
    }
  }
}
