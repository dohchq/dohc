// The marketing site: a Cloudflare Worker that serves the Vite build as
// static files. .github/workflows/site-deploy.yml deploys it from main.
// An unknown path gets 404.html with a 404 status.
{
  "name": "dohc-site",
  "compatibility_date": "2026-10-22",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" }
}
