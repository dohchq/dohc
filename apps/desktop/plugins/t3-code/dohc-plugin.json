{
  "version": 1,
  "name": "t3-code",
  "displayName": "T3 Code",
  "description": "Runs the t3 coding agent server on this workspace and opens its web app in dohc.",
  "publisher": "dohc",
  "pluginVersion": "0.0.33",
  "repository": "https://github.com/pingdotgg/t3code",
  "issues": "https://github.com/pingdotgg/t3code/issues",
  "license": "MIT",
  "icon": "icon.svg",
  "entry": "src/main.ts",
  "webApps": [{ "id": "app", "title": "T3 Code" }],
  "allowSkippedScripts": [
    "content-type",
    "eventsource",
    "express-rate-limit",
    "ip-address",
    "msgpackr",
    "msgpackr-extract",
    "node-pty",
    "path-to-regexp",
    "regex-utilities",
    "standardwebhooks",
    "undici",
    "uuid"
  ]
}
