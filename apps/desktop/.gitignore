# electron-builder output (directories.output in electron-builder.yml).
release/

# Host-built binaries staged for packaging by scripts/build-workspace-engine.mjs
# and scripts/build-cli-bin.mjs. Platform-specific and rebuilt per machine/CI
# job, so they must never be committed. electron-builder ships them from here as
# unpacked extraResources.
resources/workspace-engine/
resources/cli-bin/
resources/plugin-tools/

# scripts/stage-plugin-tools.mjs builds the new tree beside the live one and
# swaps it in with a rename. A replaced tree stays until the app that holds a
# file in it stops.
resources/plugin-tools.staging/
resources/plugin-tools.replaced-*/
