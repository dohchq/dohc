{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["react", "react-dom"],
    "typeRoots": ["./node_modules/@types"],
    "incremental": false,
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "dohc/app": ["../../packages/app-kit/src/app.tsx"],
      "dohc/ui": ["../../packages/app-kit/src/ui.tsx"],
      "dohc/charts": ["../../packages/app-kit/src/charts.tsx"],
      "dohc/icons": ["../../packages/app-kit/src/icons.ts"],
      "dohc/money": ["../../packages/app-kit/src/money.ts"],
      "dohc/csv": ["../../packages/app-kit/src/csv.ts"]
    }
  },
  "include": [
    "../../packages/app-kit/src/css.d.ts",
    "../../examples/quant-workbench/index.tsx",
    "../../examples/quant-workbench/workbench.tsx",
    "../../examples/quant-workbench/charts.tsx",
    "../../examples/quant-workbench/ingest.ts",
    "../../examples/quant-workbench/report/index.tsx"
  ]
}
