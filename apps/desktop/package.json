{
  "name": "@dohc/desktop",
  "private": true,
  "version": "0.1.0",
  "desktopName": "dohc.desktop",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @dohc/sdk build && node scripts/ensure-electron-installed.mjs && node scripts/build-cli-bin.mjs && electron-vite build",
    "build:cli": "node scripts/build-cli-bin.mjs",
    "build:engine": "node scripts/build-workspace-engine.mjs",
    "package": "pnpm --filter @dohc/sdk build && node scripts/ensure-electron-installed.mjs && pnpm run build:engine && node scripts/build-cli-bin.mjs && electron-vite build && electron-builder --publish never",
    "smoke:package": "node scripts/package-smoke.mjs",
    "smoke:settings": "node scripts/run-playwright.mjs --config playwright.config.ts --grep @settings-smoke",
    "smoke:fuses": "node scripts/ensure-electron-installed.mjs && node scripts/fuse-smoke.mjs",
    "test": "vitest run && node --test scripts/dev.test.mjs",
    "test:e2e": "pnpm run build && node scripts/require-e2e-engine.mjs && node scripts/run-playwright.mjs --config playwright.config.ts",
    "test:sites:e2e": "pnpm run build && node scripts/run-playwright.mjs --config playwright.config.ts --grep @sites",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@babel/types": "7.29.8",
    "@dohc/performance": "workspace:*",
    "@electron/asar": "^4.2.1",
    "@electron/fuses": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "js-yaml": "^5.2.3",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@dohc/brand": "workspace:*",
    "@dohc/cli": "workspace:*",
    "@dohc/mcp": "workspace:*",
    "@dohc/sdk": "workspace:*",
    "@dohc/security-contract": "workspace:*",
    "@dohc/sqlite-worker": "workspace:*",
    "@dohc/workspace-contracts": "workspace:*",
    "@dohc/workspace-core": "workspace:*",
    "@dohc/workspace-engine-client": "workspace:*",
    "@dohc/workspace-fs": "workspace:*",
    "@dohc/ydoc-projection": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-code-block": "^3.29.2",
    "@tiptap/extension-collaboration": "3.29.2",
    "@tiptap/extension-collaboration-caret": "3.29.2",
    "@tiptap/extension-list": "3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extensions": "3.29.2",
    "@tiptap/markdown": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/y-tiptap": "3.0.8",
    "@vscode/ripgrep": "^1.18.0",
    "electron-updater": "^6.8.9",
    "effect": "4.0.0-beta.107",
    "highlight.js": "~11.11.1",
    "katex": "^0.18.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.30.0",
    "mermaid": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "typescript": "^7.0.2",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "13.6.30",
    "zod": "^4.4.3"
  }
}
