{
  "name": "@dohc/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/ensure-electron-installed.mjs && electron-vite dev",
    "build": "node scripts/ensure-electron-installed.mjs && node scripts/build-workspace-kernel.mjs && node scripts/build-cli-bin.mjs && electron-vite build",
    "build:cli": "node scripts/build-cli-bin.mjs",
    "package": "node scripts/ensure-electron-installed.mjs && node scripts/build-workspace-kernel.mjs && node scripts/build-cli-bin.mjs && electron-vite build && electron-builder --publish never",
    "smoke:package": "node scripts/package-smoke.mjs",
    "smoke:settings": "playwright test --config playwright.config.ts --grep @settings-smoke",
    "smoke:fuses": "node scripts/ensure-electron-installed.mjs && node scripts/fuse-smoke.mjs",
    "test": "vitest run",
    "test:e2e": "pnpm run build && playwright test --config playwright.config.ts",
    "test:sites:e2e": "pnpm run build && playwright test --config playwright.config.ts --grep @sites",
    "typecheck": "tsc --noEmit"
  },
  "dependencyNotes": {
    "jsdom": "Pinned to ^27.2.0 because jsdom 29.1.1 pulls html-encoding-sniffer@6 through a CJS/ESM path that breaks the current Vitest 2 desktop harness; Vitest 4 migration is tracked as repo-wide test infrastructure, not this settings PR."
  },
  "devDependencies": {
    "@dohc/performance": "workspace:*",
    "@electron/asar": "^3.4.1",
    "@electron/fuses": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.19",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "42.4.1",
    "electron-builder": "^26.15.2",
    "electron-vite": "^5.0.0",
    "js-yaml": "^4.1.1",
    "jsdom": "^27.2.0",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.14",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@dohc/brand": "workspace:*",
    "@dohc/cli": "workspace:*",
    "@dohc/mcp": "workspace:*",
    "@dohc/sdk": "workspace:*",
    "@dohc/sqlite-worker": "workspace:*",
    "@dohc/workspace-contracts": "workspace:*",
    "@dohc/workspace-core": "workspace:*",
    "@dohc/workspace-engine": "workspace:*",
    "@dohc/workspace-fs": "workspace:*",
    "@dohc/workspace-kernel-client": "workspace:*",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@tiptap/core": "^3.23.6",
    "@tiptap/extension-collaboration": "3.23.6",
    "@tiptap/extension-list": "3.23.6",
    "@tiptap/extension-table": "^3.23.6",
    "@tiptap/extensions": "3.23.6",
    "@tiptap/markdown": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@vscode/ripgrep": "^1.18.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^9.1.0",
    "typescript": "^5.9.3",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30",
    "zod": "^3.25.76"
  }
}
