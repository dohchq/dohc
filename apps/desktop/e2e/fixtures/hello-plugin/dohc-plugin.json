{
  "version": 1,
  "name": "hello-plugin",
  "displayName": "Hello Plugin",
  "description": "Writes a hello note and shows a panel, for the end-to-end plugin tests.",
  "publisher": "dohc test fixtures",
  "icon": "icon.svg",
  "entry": "plugin.mjs",
  "panels": [
    { "id": "main", "title": "Hello", "entry": "panel/index.html" },
    {
      "id": "hello-view",
      "title": "Hello view",
      "entry": "view/index.html",
      "placement": "view",
      "icon": "icon.svg"
    }
  ],
  "commands": [{ "id": "hello.write", "title": "Write hello note" }],
  "settings": [
    {
      "key": "greeting",
      "type": "string",
      "label": "Greeting",
      "description": "What the hello note says.",
      "default": "Hello"
    },
    {
      "key": "shout",
      "type": "boolean",
      "label": "Shout",
      "default": false
    },
    {
      "key": "repeat",
      "type": "number",
      "label": "Repeat",
      "default": 1
    },
    {
      "key": "tone",
      "type": "select",
      "label": "Tone",
      "default": "plain",
      "options": ["plain", "warm"]
    }
  ]
}
