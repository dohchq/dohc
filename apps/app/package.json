    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "28.0.3",
    "@types/node": "^22.13.10",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.0",
    "convex-test": "^0.0.51",
