# dohc app environment — copy to .env.local and fill in real values.
# .env.local is gitignored; never commit real secrets.

# Convex deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment

VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
VITE_HOCUSPOCUS_URL=ws://127.0.0.1:1234

# WorkOS AuthKit
WORKOS_CLIENT_ID=client_xxx
WORKOS_API_KEY=sk_test_xxx
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
WORKOS_COOKIE_PASSWORD=generate_a_32+_char_random_string

# Anthropic (only needed to run the live eval / agent locally)
# ANTHROPIC_API_KEY=sk-ant-xxx

# Optional dohc feature flags
# VITE_DOHC_INLINE_ATOMS=1
