# dohc cloud web client environment — copy to .env.local and fill in real
# values. .env.local is gitignored; never commit real secrets.

# Origin of the dohc workspace API (Better Auth sessions + workspace routes).
# Leave unset for same-origin deployments. When set, it must be SAME-SITE
# with the web origin (session cookies are SameSite=Lax): shared registrable
# domain, or matching hosts in dev. localhost web + 127.0.0.1 API is
# cross-site — the cookie is never sent and authed calls 401.
# VITE_DOHC_CLOUD_URL=http://localhost:1786
