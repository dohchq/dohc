# dohc app environment — copy to .env.local and fill in real values.
# .env.local is gitignored; never commit real secrets.

# Convex deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment

VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
VITE_HOCUSPOCUS_URL=ws://127.0.0.1:1234

# Hocuspocus/Convex bridge values are set in Convex env, not exposed to Vite:
# For local compose, these must match docker-compose.dev.yml defaults or your exported overrides.
# pnpm --filter @dohc/app exec convex env set HOCUSPOCUS_JWT_SECRET 'dev-jwt-secret-change-me-with-at-least-32-bytes'
# pnpm --filter @dohc/app exec convex env set HOCUSPOCUS_CONVEX_SERVER_TOKEN 'generate_a_server_secret'
# pnpm --filter @dohc/app exec convex env set HOCUSPOCUS_ADMIN_URL 'http://127.0.0.1:1234'
# pnpm --filter @dohc/app exec convex env set HOCUSPOCUS_ADMIN_TOKEN 'dev-admin-token-change-me'

# WorkOS AuthKit
WORKOS_CLIENT_ID=client_xxx
WORKOS_API_KEY=sk_test_xxx
WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/callback
WORKOS_COOKIE_PASSWORD=generate_a_32+_char_random_string

# Agent providers (set at least one key on the server)
# OpenAI is the default when both keys are present. Anthropic stays available
# as a direct provider; no in-app secret setup is required for self-hosting.
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-ant-xxx
# DOHC_DEFAULT_PROVIDER=openai
# DOHC_DEFAULT_MODEL=gpt-5.5

# Optional dohc feature flags
# VITE_DOHC_INLINE_ATOMS=1
