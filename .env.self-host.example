# Generate .env.self-host with: node tools/self-host/bootstrap.mjs init --origin https://dohc.example.com
# Then configure SMTP and build the release before starting it.
DOHC_PUBLIC_ORIGIN=https://dohc.example.com
DOHC_PUBLIC_HOST=dohc.example.com
DOHC_IMAGE=dohc-self-host:change-me
DOHC_DEPLOYMENT_NAME=dohc-self-host
DOHC_SERVER_NAME=dohc
DOHC_SERVER_NETWORK_ACCESS=public

POSTGRES_DB=dohc
POSTGRES_USER=dohc
POSTGRES_PASSWORD=change-me

# Leave empty to run the bundled database on this host.
# To keep accounts in an external Postgres, set its host, port and CA certificate,
# and set the POSTGRES_ values above to its database, user and password. See docs/how-to/self-host.md.
DOHC_POSTGRES_HOST=
DOHC_POSTGRES_PORT=
DOHC_POSTGRES_CA_FILE=

BETTER_AUTH_SECRET=change-me
DOHC_RELAY_LINK_KEY=change-me
DOHC_RELAY_EXCHANGE_KEY=change-me

# SMTP must support TLS. Use port 465 and true for implicit TLS.
DOHC_SMTP_HOST=change-me
DOHC_SMTP_PORT=587
DOHC_SMTP_SECURE=false
DOHC_SMTP_USER=
DOHC_SMTP_PASSWORD=
DOHC_SMTP_FROM=change-me

# Leave empty to let anyone who reaches this server create an account.
# To close sign-up, list approved email addresses separated by commas.
# An address with a pending share invite can then also sign up.
DOHC_SIGN_UP_EMAILS=

# Leave empty to keep relay data in Docker volumes on this host.
# To keep it on an attached disk, name a folder on that disk. See docs/how-to/self-host.md.
DOHC_DATA_DIRECTORY=

# Change these values together if this Docker subnet conflicts with your network.
DOHC_NETWORK_SUBNET=10.233.42.0/24
DOHC_NETWORK_IP_RANGE=10.233.42.128/25
DOHC_GATEWAY_ADDRESS=10.233.42.2
DOHC_SHARE_WEB_ADDRESS=10.233.42.3

# Server automations are on by default. Set 0 and restart to turn them off.
DOHC_RELAY_AUTOMATIONS=1

# App publishing also needs a separate app domain and its HTTPS proxy setup.
DOHC_RELAY_APP_PUBLICATIONS=0
DOHC_RELAY_APP_BACKEND_MAX_PARTICIPANTS_PER_GRANT=1000
DOHC_RELAY_APP_COLLECTION_MAX_CREATES_PER_GRANT=0
DOHC_SHARE_WEB_APP_DOMAIN=
