# Copy to .env.self-host and replace every change-me value before exposing.
POSTGRES_DB=dohc
POSTGRES_USER=dohc
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=54329

WORKSPACE_API_PORT=1786
# Use the public HTTPS auth URL. Both auth services use it for secure cookies.
WORKSPACE_API_BASE_URL=https://auth.example.com
# Shared by workspace-api AND sync-relay: bearer tokens minted by the
# workspace-api device flow must validate at the relay, so both services
# read the SAME secret (>=32 chars; `openssl rand -base64 32`).
BETTER_AUTH_SECRET=change-me-with-at-least-32-bytes-for-better-auth

SYNC_RELAY_PORT=1788
# The sync relay serves share links, so it reads shared content in plaintext.
# A link secret hides the work from other people, not from this relay.
DOHC_RELAY_LINK_KEY=change-me-with-at-least-32-random-bytes
DOHC_RELAY_EXCHANGE_KEY=change-me-with-at-least-32-random-bytes
# Immutable app publication routes stay off unless you set this to 1.
DOHC_RELAY_APP_PUBLICATIONS=0
# Set the public HTTP(S) URL that desktop clients use to reach this relay.
DOHC_SHARE_WEB_PUBLIC_RELAY_URL=https://relay.example.com

# Set the HTTPS origin and exact Host that your proxy forwards to share-web.
DOHC_SHARE_WEB_PUBLIC_ORIGIN=https://share.example.com
DOHC_SHARE_WEB_PUBLIC_HOST=share.example.com
# List exact proxy peer addresses. Leave empty when share-web has no trusted
# proxy. Do not guess an address: a proxy in another container is not 127.0.0.1.
DOHC_SHARE_WEB_TRUSTED_PROXIES=
DOHC_SHARE_WEB_PORT=1790
