# Copy to .env.self-host and replace every change-me value before exposing.
DOHC_BACKEND=postgres

POSTGRES_DB=dohc
POSTGRES_USER=dohc
POSTGRES_PASSWORD=change-me
# Auth secret for workspace-api (openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me
POSTGRES_PORT=54329

MINIO_ROOT_USER=dohc
MINIO_ROOT_PASSWORD=change-me-too
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_CONSOLE_PORT=9001

HOCUSPOCUS_ADMIN_TOKEN=change-me-hocuspocus-admin-token
HOCUSPOCUS_JWT_SECRET=change-me-with-at-least-32-bytes-for-hocuspocus
HOCUSPOCUS_ALLOW_DEV_ACL=false
HOCUSPOCUS_PORT=1234
HOCUSPOCUS_PUBLIC_URL=ws://127.0.0.1:1234

WORKSPACE_API_PORT=1786
WORKSPACE_API_BASE_URL=http://127.0.0.1:1786

SQLITE_WORKER_PORT=1787
SQLITE_WORKER_TOKEN=change-me-sqlite-worker-token
SQLITE_WORKER_ALLOW_INSECURE_LOCAL=0

APP_TESTER_PORT=1788
APP_TESTER_TOKEN=change-me-app-tester-token
APP_TESTER_ALLOW_INSECURE_LOCAL=0

WEB_PORT=3000
